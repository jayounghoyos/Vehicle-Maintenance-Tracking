    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --selectProjects integration",
    "dev": "nest start --watch",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
