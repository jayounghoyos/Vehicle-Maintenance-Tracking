# Copy to .env. docker compose and the API both read this file.

# One connection string, the shape a managed provider hands over. Set
# this and the five DB_ values below are ignored. Leave it empty to use
# the postgres container from docker compose.
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

DB_HOST=localhost
# 5433, not 5432: a system postgres often already holds 5432
DB_PORT=5433
DB_USER=mts
DB_PASSWORD=mts
DB_NAME=mts

# 3002: editors and other dev servers commonly squat 3000/3001
PORT=3002
WEB_ORIGIN=http://localhost:5173

# openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# seconds
JWT_EXPIRES_IN=43200

# Where vehicle photos live. Free plan, and the cloud name is not a
# secret: it is in every image URL the browser loads. The other two are.
# Leave them empty and the app runs with photo upload switched off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
