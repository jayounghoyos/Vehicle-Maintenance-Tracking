# Copy to .env. docker compose and the API both read this file.
DB_HOST=localhost
# 5433, not 5432: a system postgres often already holds 5432
DB_PORT=5433
DB_USER=mts
DB_PASSWORD=mts
DB_NAME=mts

# 3002: editors and other dev servers commonly squat 3000/3001
PORT=3002
WEB_ORIGIN=http://localhost:5173
